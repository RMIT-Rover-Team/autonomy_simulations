<?xml version="1.0"?>
<model>
  <name>Mars Terrain 2</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>

  <author>
    <name>Generated with Claude</name>
  </author>

  <description>
    Static 12.8m x 12.8m Mars terrain (variant 2): 4 crater tiles (2x
    masr_crater_2, 2x artificial_crater) seamlessly blended into flat
    regolith ground via ramped edge skirts, bordered by a perimeter curb,
    and scattered with 27 rocks from two rock packs (25 on open ground,
    2 small ones buried inside craters). Built for use as a static
    ground-plane model in a robot navigation simulation.
  </description>
</model>
